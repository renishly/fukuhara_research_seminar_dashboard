# Copy this file to .env and fill in your own values:
#     cp .env.example .env          (Windows: copy .env.example .env)
# Never commit .env (it's already in .gitignore).
# Generate random values with (see the README):
#     python -c "import secrets; print(secrets.token_hex(32))"

# --- Registration keys --------------------------------------------------------
# Needed once, when someone registers (never at login). They must be different.
# Leaving one empty switches off registration for that role.
# Keep the admin key private; change the student key each year (existing
# accounts keep working).
ADMIN_REGISTRATION_KEY=
STUDENT_REGISTRATION_KEY=

# --- Agent API keys -------------------------------------------------------------
# Encrypts agents' API keys in the database, so owners can "View key" again.
# It must be a Fernet key. Make one with:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Don't change or lose it: keys saved with an old secret can't be viewed any
# more ("Replace key" fixes each agent).
KEY_ENCRYPTION_SECRET=

# --- Database ------------------------------------------------------------------
# Leave empty to use a local SQLite file (./local.db). On Render, this is
# Supabase's "Session pooler" connection string, ending in ?sslmode=require.
DATABASE_URL=

# --- File storage ------------------------------------------------------------------
# Leave both empty to keep files in ./local_files/. On Render, set them to your
# Supabase project's URL and its secret service key (server only: never put
# the service key in a page or in the repository).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=seminar-files

# --- The Agent Skills market's organizer (optional) ------------------------------
# With an OpenRouter key, an AI model sorts skills into categories and writes
# their descriptions (at most twice a day: OpenRouter's free tier allows very
# few requests). Without one, simple keyword rules are used instead.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# A long random value; the daily GitHub timer sends it to start the organizer.
ORGANIZER_TOKEN=

# --- The demo agent (agent/agent.py) only, not the website ---------------------
# DASHBOARD_API_KEY: the demo agent's key, from "Add Agent" on your agent dashboard.
# DASHBOARD_URL: where the website is (default http://127.0.0.1:8000).
DASHBOARD_API_KEY=
DASHBOARD_URL=http://127.0.0.1:8000
